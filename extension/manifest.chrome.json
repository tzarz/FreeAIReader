{
  "manifest_version": 3,
  "name": "FreeAIReader",
  "version": "0.1.0",
  "description": "Free, ad-free local AI voices for webpages and PDFs.",
  "permissions": ["contextMenus", "storage"],
  "optional_permissions": ["downloads"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8080/*", "http://localhost:8080/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "FreeAIReader settings" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
